# PSX Intelligence AI — database environment TEMPLATE (Phase 2, Team D).
# Copy to .env and fill in a real password. NEVER commit .env.
# .env is listed in database/.gitignore. Rotate the password if it is ever
# shared, pasted into chat, or committed by mistake.
# The backend team owns backend/ code; this file is the database-side
# contract for the connection string it is expected to read.
DATABASE_URL=postgresql://psx_app:CHANGE_ME@localhost:5432/psx_intelligence
PGHOST=localhost
PGPORT=5432
PGDATABASE=psx_intelligence
PGUSER=psx_app
PGPASSWORD=CHANGE_ME
# Storage root (relative to the project root, or absolute on the operator's machine).
# Never store an absolute machine path in the database itself (Phase 1 rule).
PSX_STORAGE_ROOT=storage
