# PSX Intelligence AI — example environment configuration (Phase 2, Team A)
# =============================================================================
# COPY this file to `.env` for local development and fill in YOUR OWN values:
#   cp .env.example .env
# NEVER commit `.env`. NEVER put a real secret, password, API key, or personal
# credential in this file or in `.env` committed anywhere.
# By design this project has NO external AI API key, NO broker credential, and
# NO paid-service key: there is intentionally no variable for any of those.
# All values below are placeholders. See docs/phase-02/LOCAL_DEVELOPMENT_GUIDE.md
# for the configuration contract (which vars are required, defaults, validation).
# =============================================================================

# --- Runtime environment: dev | test | prod (default: dev) ---
APP_ENV=dev
DEBUG=true

# --- Frontend (Next.js) ---
# Public URL the browser uses to reach the backend API. Local dev default only.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PSX Intelligence AI

# --- Backend (FastAPI / Uvicorn) ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# CORS origins for local dev only (comma-separated). Production values are set
# by the deployment owner, never copied from this example.
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local-dev default: SQLite file (dev-only, never production).
# Production: PostgreSQL (self-hosted). Replace the placeholders with your own
# local credentials when you run PostgreSQL; never use a shared/production password.
DATABASE_URL=sqlite:///./dev.db
# Example production-shape URL (placeholders only, do NOT use as-is):
# DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@localhost:5432/psx_intelligence

# --- Redis (Celery broker + result backend; self-hosted, local dev) ---
# Redis is NOT installed on the Phase 2 audit machine (see
# docs/phase-02/ENVIRONMENT_AUDIT.md). Until it is installed, workers cannot run;
# the API and tests must work without it. When installed locally, use:
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage (local filesystem only; MinIO is OPTIONAL and NOT ADOPTED) ---
STORAGE_BASE_DIR=./storage
STORAGE_RAW_DIR=./storage/raw
STORAGE_PROCESSED_DIR=./storage/processed
STORAGE_REPORTS_DIR=./storage/research_reports
STORAGE_PARQUET_DIR=./storage/parquet
STORAGE_BACKUPS_DIR=./storage/backups

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=./logs/app.log

# --- Local AI (Ollama, LOCAL inference only) ---
# Ollama is optional: every core feature works with Ollama absent or with no
# model downloaded. No cloud model, no Ollama Cloud, no API key — ever.
OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL is intentionally left blank. A model is chosen only via the
# ADR-007 evaluation gate (licence checked first) and is NEVER pinned here
# without that gate. Leave blank until then.
OLLAMA_MODEL=

# --- Development ---
# Frontend dev server port (Next.js default).
FRONTEND_PORT=3000
# Python virtual environment directory (created by the developer, not committed).
VENV_DIR=.venv

# --- Test ---
# Test database: a separate throwaway SQLite file. Tests must never touch a
# developer's dev.db or any production database.
TEST_DATABASE_URL=sqlite:///./test.db

# --- Production (set ONLY in the production environment, never in this file) ---
# In production: APP_ENV=prod, DEBUG=false, DATABASE_URL points at self-hosted
# PostgreSQL, CORS_ORIGINS lists only the real frontend origin, and LOG_LEVEL
# is INFO or WARNING. Production secrets live in the production environment's
# own secret store, never in the repository.
