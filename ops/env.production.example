# PSX Intelligence AI — PRODUCTION environment template (Phase 28).
# Copy the values you need into the production environment's own store
# (database/.env for the database contract; the backend reads DATABASE_URL,
# CORS_ORIGINS and AUTH_* from the environment). NEVER commit a filled-in
# copy: every .env is gitignored, and this template contains placeholders only.
#
# Production boot rules enforced by the backend (config.py):
#   - ENVIRONMENT=production REQUIRES AUTH_ENFORCEMENT=on (else it refuses
#     to boot) and REJECTS a wildcard CORS origin.
#   - AUTH_ENFORCEMENT=on with zero accounts is fail-closed (401 on every
#     protected route): create the first admin account with
#     scripts/manage_auth.py BEFORE switching enforcement on.
#     (No live accounts exist yet — that creation is a parent/user decision.)
#
# Backend
ENVIRONMENT=production
DATABASE_URL=<redacted>
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AUTH_ENFORCEMENT=on
AUTH_TOKEN_TTL_HOURS=24
AUTH_SERVICE_TOKEN_TTL_DAYS=90
AUTH_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_AUTH_PER_MINUTE=30
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
LOG_LEVEL=INFO
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
#
# Database contract (database/.env — same file the backend reads)
PGHOST=localhost
PGPORT=5432
PGDATABASE=psx_intelligence
PGUSER=psx_app
PGPASSWORD=<redacted>
#
# Storage + backups (operator paths; never a machine path inside the DB)
PSX_STORAGE_ROOT=storage
PSX_BACKUP_ROOT=storage/backups
# Optional backup encryption (Phase 28): set to a GPG recipient (key id or
# email) to encrypt backups. UNSET = plaintext backups (the current default).
# No key is created by this project: the operator creates one first
# (gpg --full-generate-key) and keeps the private key OFF this machine's
# backups. Without a key, encryption stays off and backups stay plaintext.
BACKUP_GPG_RECIPIENT=
#
# Frontend build-time values (baked into `next build`, NOT read at runtime)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=PSX Intelligence AI
#
# Deliberately ABSENT (this project has none, by design):
# no external AI API key, no broker credential, no paid-service key,
# no Docker variable (Docker is not used — user decision 2026-11-04).
