# PSX Intelligence AI — backend environment template (Phase 2).
# Copy to .env and fill in. NEVER commit a real .env, password or key.
# .env is gitignored; this example contains no real credentials.
APP_NAME=psx-intelligence-ai
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
# Database URL. The database team owns the actual PostgreSQL installation.
# Leave empty until it is available: the API then reports db: unavailable.
# Format (placeholders only, not a real credential):
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=
# Comma-separated allowed CORS origins. No wildcard in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
